---
import { site } from '../data/site';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const asset = (file: string) => base + file.replace(/^\//, '');
const tickets = site.links.tickets || '#contato';
const courseLink = site.links.courses || '#contato';
const linkProps = (url: string) => url.startsWith('http') ? { target: '_blank', rel: 'noopener noreferrer' } : {};
const interestOptions = ['Um curso', 'Ingresso ou visita', 'Evento', 'Visita em grupo ou escola', 'Outro assunto'];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#092531" />
    <meta name="description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Instituto BIA Beltrão | O espaço da arte e cultura paraibana" />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={new URL(asset('bia-fachada-hd.webp'), Astro.site || 'https://joao-juvino.github.io').toString()} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Italiana&display=swap" rel="stylesheet" />
    <title>Instituto BIA Beltrão | Arte, exposições, ingressos e cursos</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <header class="site-header" id="inicio">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Instituto BIA Beltrão, voltar ao início">
          <img src={asset('brand.svg')} alt="BIA Beltrão" width="86" height="40" />
        </a>
        <nav class="desktop-nav" aria-label="Navegação principal">
          <a href="#ingressos">Ingressos</a>
          <a href="#visita">A visita</a>
          <a href="#cursos">Cursos</a>
          <a href="#instituto">O instituto</a>
          <a href="#duvidas">Dúvidas</a>
        </nav>
        <a href={tickets} class="btn btn-coral header-cta" data-interest="Ingresso ou visita" {...linkProps(tickets)}>Comprar ingresso</a>
        <details class="mobile-menu">
          <summary aria-label="Abrir menu"><span></span><span></span><span></span></summary>
          <nav aria-label="Menu mobile">
            <a href="#ingressos">Ingressos</a>
            <a href="#visita">A visita</a>
            <a href="#cursos">Cursos</a>
            <a href="#instituto">O instituto</a>
            <a href="#duvidas">Dúvidas</a>
            <a href="#contato">Contato</a>
          </nav>
        </details>
      </div>
      <div class="color-track" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </header>
    <main id="conteudo">
      <section class="hero dark-section" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow muted">Instituto de Artes · Paraíba</p>
            <h1 id="hero-title" class="display-heading">O espaço da<br /><em>arte e cultura</em><br />paraibana</h1>
            <p class="hero-description">Um grande acervo de arte do estado, onde quem cria encontra quem admira. Compre seu ingresso ou escolha seu curso.</p>
            <div class="action-row">
              <a href={tickets} data-interest="Ingresso ou visita" {...linkProps(tickets)} class="btn btn-coral">Comprar ingresso</a>
              <a href="#cursos" class="btn btn-outline-light">Ver cursos</a>
            </div>
            <p class="fine-print">Pagamento por Pix ou cartão</p>
          </div>
          <div class="hero-art">
            <span class="accent-block accent-gold" aria-hidden="true"></span>
            <img
              class="hero-photo"
              src={asset(site.heroImage.src)}
              alt={site.heroImage.alt}
              width="960"
              height="539"
              fetchpriority="high"
              onerror={'this.onerror=null;this.src=' + JSON.stringify(asset(site.heroImage.fallback))}
            />
            <span class="accent-block accent-coral" aria-hidden="true"></span>
          </div>
        </div>
      </section>

      <section class="visit-strip" aria-label="Informações de visita">
        <div class="container visit-strip-grid">
          <div class="visit-detail"><span class="eyebrow coral">Horários</span><p>{site.visit.hours}</p></div>
          <div class="visit-detail"><span class="eyebrow coral">Onde</span><p>{site.visit.address}</p></div>
          <div class="visit-detail"><span class="eyebrow coral">Contato</span><p><a href={'tel:+558332040264'}>{site.visit.phone}</a></p></div>
          <div class="visit-detail"><span class="eyebrow coral">Como chegar</span><p><a href={site.links.maps} target="_blank" rel="noopener noreferrer">Ver no mapa</a></p></div>
        </div>
      </section>

      <section class="section tickets-section" id="ingressos" aria-labelledby="tickets-title">
        <div class="container">
          <p class="eyebrow coral">Ingressos</p>
          <h2 id="tickets-title" class="display-heading">No mês de abertura do BIA, todos pagam meia!</h2>
          <p class="section-intro">Escolha o dia, a quantidade e garanta sua vaga. Nosso time comercial está disponível para atender você.</p>
          <div class="ticket-grid">
            {site.ticketTypes.map(ticket => (
              <article class={'ticket-card stripe-' + ticket.color}>
                <h3>{ticket.name}</h3>
                <p>{ticket.description}</p>
                {ticket.name === 'Inteira' && <span class="ticket-marker" aria-hidden="true"></span>}
              </article>
            ))}
          </div>
          <a href={tickets} class="btn btn-coral ticket-action" data-interest="Ingresso ou visita" {...linkProps(tickets)}>Comprar ingresso</a>
        </div>
      </section>

      <section class="section experiences-section" id="visita" aria-labelledby="experiences-title">
        <div class="container">
          <p class="eyebrow coral">A visita</p>
          <h2 id="experiences-title" class="display-heading experience-heading">Uma visita, quatro jeitos<br />de entrar na arte</h2>
          <div class="experience-grid">
            {site.experiences.map(experience => (
              <article class="experience-card">
                <div class="card-kicker">
                  <span class={'shape ' + experience.shape + ' bg-' + experience.color} aria-hidden="true"></span>
                  <span class="eyebrow">{experience.name}</span>
                </div>
                <h3>{experience.title}</h3>
                <p>{experience.description}</p>
                {'note' in experience && <span class="reference-note">{experience.note}</span>}
              </article>
            ))}
          </div>
          <a href={tickets} class="btn btn-coral" data-interest="Ingresso ou visita" {...linkProps(tickets)}>Escolher meu ingresso</a>
        </div>
      </section>

      <section class="section courses-section" id="cursos" aria-labelledby="courses-title">
        <div class="container">
          <p class="eyebrow coral">Cursos</p>
          <div class="courses-intro">
            <h2 id="courses-title" class="display-heading">Aprenda arte com<br />quem vive de arte</h2>
            <p>Cursos do Instituto BIA para quem quer começar, retomar ou aprofundar o olhar. Veja as turmas abertas e garanta a sua vaga.</p>
          </div>
          <div class="course-grid">
            {site.courses.map(course => {
              const url = course.url || courseLink;
              return (
                <article class="course-card">
                  <span class={'status status-' + course.statusColor}>{course.status}</span>
                  <h3>{course.name}</h3>
                  <p class="course-description">{course.description}</p>
                  <div class="course-meta">
                    <span>Professor: {course.teacher}</span><span>{course.period}</span><span>{course.duration}</span>
                  </div>
                  <div class="course-pricing"><span class="old-price">De {course.oldPrice}</span><strong>Por {course.price}</strong></div>
                  <a href={url} class="btn btn-coral btn-full" data-interest="Um curso" {...linkProps(url)}>Quero me inscrever</a>
                </article>
              );
            })}
          </div>
          <div class="courses-notice">No momento não há inscrições abertas? Deixe seu e-mail e avisamos antes de todo mundo.</div>
        </div>
      </section>

      <section class="section about-section dark-section" id="instituto" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-copy">
            <p class="eyebrow muted">O instituto</p>
            <h2 id="about-title" class="display-heading">A Paraíba ganhou<br />um instituto de artes</h2>
            <p>Tudo começou em 2014, com a família Beltrão e o amor pela arte que perpassa gerações. Surgiu uma ideia ousada para valorizar a arte da Paraíba: proporcionar a artistas em ascendência e que possuem legado consolidado uma oportunidade para compartilhar suas artes.</p>
            <p>A aposta deu certo. Obra a obra, a coleção cresce até se tornar um grande acervo de arte da Paraíba, com mais de mil pinturas, esculturas e peças que carregam a identidade do estado. Em 2023, nasceu oficialmente o Beltrão Instituto de Artes, um espaço de arte e cultura paraibana.<br />Uma paixão desse tamanho pede para ser compartilhada. Por isso o BIA abre suas portas para que cada paraibano e cada visitante possa conhecer a história da Paraíba e se sentir parte dela.</p>
            <a href={tickets} class="btn btn-coral" data-interest="Ingresso ou visita" {...linkProps(tickets)}>Comprar ingresso</a>
          </div>
          <ul class="stat-list" aria-label="O Instituto em números">
            {site.statistics.map(stat => (
              <li class="stat-item">
                <span class={'stat-dot bg-' + stat.color} aria-hidden="true"></span>
                <div><strong>{stat.value}</strong><p>{stat.label}</p></div>
              </li>
            ))}
          </ul>
        </div>
      </section>

      <div class="reassurance-strip">
        <div class="container reassurance-items">
          <span>Pagamento seguro</span>
          <span>Ingresso enviado por e-mail na hora</span>
          <span>Atendimento por WhatsApp: {site.visit.phone}</span>
        </div>
      </div>

      <section class="section faq-section" id="duvidas" aria-labelledby="faq-title">
        <div class="faq-container">
          <p class="eyebrow coral">Perguntas frequentes</p>
          <h2 id="faq-title" class="display-heading">Tem alguma dúvida?</h2>
          <div class="faq-list">
            {site.faqs.map(faq => (
              <details class="faq-item" name="faq">
                <summary>{faq.question}<span class="faq-icon" aria-hidden="true"></span></summary>
                <div class="faq-answer"><p>{faq.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="closing-section" id="contato" aria-labelledby="closing-title">
        <div class="container closing-grid">
          <div class="closing-copy">
            <p class="eyebrow">Fale com a gente!</p>
            <h2 class="display-heading" id="closing-title">A arte está<br />esperando<br />por você</h2>
            <p>Deixe seus dados e conte o que você procura: um curso, um evento ou uma visita. A gente retorna para combinar tudo com você.</p>
          </div>
          <form class="contact-form" id="contact-form" data-email={site.links.email}>
            <label for="contact-name">Nome:</label>
            <input id="contact-name" name="nome" type="text" placeholder="Seu nome completo" autocomplete="name" required minlength="2" />
            <label for="contact-phone">Telefone:</label>
            <input id="contact-phone" name="telefone" type="tel" placeholder="(00) 0000-0000" autocomplete="tel" required minlength="8" />
            <label for="contact-email">E-mail</label>
            <input id="contact-email" name="email" type="email" placeholder="você@email.com" autocomplete="email" required />
            <label for="contact-interest">Tenho interesse em:</label>
            <select id="contact-interest" name="interesse" required>
              <option value="" disabled selected>Selecione uma opção</option>
              {interestOptions.map(option => <option value={option}>{option}</option>)}
            </select>
            <button type="submit" class="btn btn-coral btn-full">Enviar contato</button>
            <p class="form-feedback" id="form-feedback" role="status" aria-live="polite"></p>
          </form>
        </div>
      </section>
    </main>
    <footer class="site-footer dark-section">
      <div class="container footer-inner">
        <a class="footer-brand" href="#inicio" aria-label="Voltar ao início">
          <img src={asset('brand.svg')} alt="BIA Beltrão" width="116" height="53" loading="lazy" />
        </a>
        <div class="footer-contact">
          <p class="eyebrow muted">{site.fullName}</p>
          <p>{site.visit.address}</p>
          <p>WhatsApp {site.visit.phone} · E-mail: <a href={'mailto:' + site.links.email}>{site.links.email}</a></p>
          <p>Instagram: <a href={site.links.instagram} target="_blank" rel="noopener noreferrer">@biainstitutodeartes</a></p>
        </div>
        <nav class="footer-links" aria-label="Informações legais">
          {site.links.privacy ? <a href={site.links.privacy}>Política de privacidade</a> : <span>Política de privacidade</span>}
          {site.links.terms ? <a href={site.links.terms}>Termos de compra</a> : <span>Termos de compra</span>}
        </nav>
      </div>
    </footer>
    <script is:inline>
      const form = document.getElementById('contact-form');
      const interest = document.getElementById('contact-interest');
      document.querySelectorAll('[data-interest]').forEach(function (link) {
        link.addEventListener('click', function () {
          if (link.getAttribute('href') === '#contato' && interest) interest.value = link.dataset.interest || '';
        });
      });
      if (form) {
        form.addEventListener('submit', function (event) {
          event.preventDefault();
          if (!form.reportValidity()) return;
          const values = new FormData(form);
          const name = String(values.get('nome') || '').trim();
          const phone = String(values.get('telefone') || '').trim();
          const email = String(values.get('email') || '').trim();
          const subject = 'Contato pelo site BIA - ' + String(values.get('interesse') || '');
          const body = ['Nome: ' + name, 'Telefone: ' + phone, 'E-mail: ' + email, 'Interesse: ' + values.get('interesse')].join('\n');
          document.getElementById('form-feedback').textContent = 'Seu aplicativo de e-mail será aberto para você confirmar o envio da mensagem.';
          window.location.href = 'mailto:' + encodeURIComponent(form.dataset.email) + '?subject=' + encodeURIComponent(subject) + '&body=' + encodeURIComponent(body);
        });
      }
    </script>
  </body>
</html>
