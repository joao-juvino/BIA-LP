---
import { site } from '../data/site';
import '../styles/global.css';

const base = import.meta.env.BASE_URL;
const asset = (file: string) => base + file.replace(/^\//, '');
// Enquanto a bilheteria oficial não estiver configurada, a compra é atendida pelo WhatsApp.
const tickets = site.links.tickets || site.links.whatsapp;
const external = { target: '_blank', rel: 'noopener noreferrer' };
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#09222f" />
    <meta name="description" content={site.description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content="Instituto BIA Beltrão | O espaço da arte e cultura paraibana" />
    <meta property="og:description" content={site.description} />
    <meta property="og:image" content={new URL(asset('bia-fachada-hd.webp'), Astro.site || 'https://joao-juvino.github.io').toString()} />
    <link rel="icon" href={asset('favicon.svg')} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Italiana&family=Jost:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <title>Instituto BIA Beltrão | Arte, exposições, ingressos e cursos</title>
  </head>
  <body>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>

    <header class="site-header" id="inicio">
      <div class="container header-inner">
        <a class="brand" href="#inicio" aria-label="Instituto BIA Beltrão, voltar ao início">
          <img src={asset('brand.svg')} alt="Logomarca do Instituto BIA Beltrão" width="902" height="542" />
        </a>
        <nav class="main-nav" aria-label="Navegação principal">
          <a href="#ingressos">Ingressos</a>
          <a href="#cursos">Cursos</a>
          <a href="#instituto">O instituto</a>
          <a href="#duvidas">Dúvidas</a>
        </nav>
        <a href={tickets} class="btn btn-coral header-cta" {...external}>Comprar ingresso</a>
      </div>
      <div class="color-track" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span><span></span></div>
    </header>

    <main id="conteudo">
      <section class="hero" aria-labelledby="hero-title">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow hero-eyebrow">Instituto de Artes - Paraíba</p>
            <h1 id="hero-title" class="display">O espaço da<br /><span class="gold">arte e cultura</span><br />paraibana</h1>
            <p class="hero-description">Um grande acervo de arte do estado, onde quem cria encontra quem admira. Compre seu ingresso ou confira os cursos que serão oferecidos.</p>
            <div class="hero-actions">
              <a href={tickets} class="btn btn-coral" {...external}>Comprar ingresso</a>
              <a href="#cursos" class="btn btn-outline">Ver cursos</a>
            </div>
          </div>
          <div class="hero-art">
            <span class="accent accent-gold" aria-hidden="true"></span>
            <span class="accent accent-coral" aria-hidden="true"></span>
            <img
              class="hero-photo"
              src={asset(site.heroImage.src)}
              alt={site.heroImage.alt}
              width="414"
              height="298"
              fetchpriority="high"
              onerror={'this.onerror=null;this.src=' + JSON.stringify(asset(site.heroImage.fallback))}
            />
          </div>
        </div>
      </section>

      <section class="visit-strip" aria-label="Informações de visita">
        <div class="container visit-grid">
          <div class="visit-item">
            <p class="eyebrow">Horários</p>
            <p>Terça a sábado,<br class="mobile-only" /> das 9h às 17h</p>
          </div>
          <div class="visit-item">
            <p class="eyebrow">Onde</p>
            <p>Rua Vigário Sarlen, 29 - Centro<span class="desktop-only"> Histórico</span>, João Pessoa - PB</p>
          </div>
          <div class="visit-item">
            <p class="eyebrow">Contato</p>
            <p><a href={site.visit.phoneHref}>{site.visit.phone}</a></p>
          </div>
          <div class="visit-item">
            <p class="eyebrow">Como chegar</p>
            <p><a class="underline" href={site.links.maps} {...external}>Ver no mapa</a></p>
          </div>
        </div>
      </section>

      <section class="tickets" id="ingressos" aria-labelledby="tickets-title">
        <div class="container">
          <p class="eyebrow section-eyebrow">Ingressos</p>
          <h2 id="tickets-title" class="display">No mês de<br class="mobile-only" /> abertura do<br class="mobile-only" /> BIA, todos<br class="mobile-only" /> pagam meia!</h2>
          <p class="tickets-intro">Escolha o dia, a quantidade e garanta sua vaga. Nosso time comercial está disponível para atender você.</p>
          <div class="ticket-grid">
            {site.ticketTypes.map(ticket => (
              <article class={'ticket-card stripe-' + ticket.color}>
                <h3 class="display">{ticket.name}</h3>
                <p>{ticket.description}</p>
                {'price' in ticket && <strong class="ticket-price">{ticket.price}</strong>}
              </article>
            ))}
          </div>
          <a href={tickets} class="btn btn-coral section-cta" {...external}>Comprar ingresso</a>
        </div>
      </section>

      <section class="experiences" id="visita" aria-labelledby="experiences-title">
        <div class="container">
          <p class="eyebrow section-eyebrow">A visita</p>
          <h2 id="experiences-title" class="display">Uma visita,<br class="mobile-only" /> quatro jeitos<br class="desktop-only" /> de<br class="mobile-only" /> entrar na arte</h2>
          <div class="experience-grid">
            {site.experiences.map(experience => (
              <article class="experience-card">
                <div class="experience-kicker">
                  <span class={'shape ' + experience.shape + ' bg-' + experience.color} aria-hidden="true"></span>
                  <span class="eyebrow">{experience.name}</span>
                </div>
                <h3 class="display">{experience.title.map((line, i) => <>{i > 0 && <br />}{line}</>)}</h3>
                <p>{experience.description}</p>
              </article>
            ))}
          </div>
          <a href={tickets} class="btn btn-coral section-cta" {...external}>Escolher meu ingresso</a>
        </div>
      </section>

      <section class="courses" id="cursos" aria-labelledby="courses-title">
        <div class="container">
          <p class="eyebrow section-eyebrow">Cursos</p>
          <h2 id="courses-title" class="display">Aprenda arte<br class="mobile-only" /> com<br class="desktop-only" /> quem<br class="mobile-only" /> vive de arte</h2>
          <p class="courses-intro">Cursos do Instituto Bia para quem quer começar, retomar ou aprofundar o olhar. Veja as turmas abertas e garanta a sua vaga.</p>
        </div>
        <div class="carousel" data-carousel>
          <button class="carousel-arrow prev" type="button" aria-label="Cursos anteriores" aria-controls="course-track" data-dir="-1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6 8.5 12l6 6" /></svg>
          </button>
          <div class="course-track" id="course-track" role="region" aria-roledescription="carrossel" aria-label="Cursos oferecidos pelo Instituto BIA" tabindex="0">
            {site.courses.map(course => (
              <article class="course-card">
                <span class="course-tag">Em breve</span>
                <h3>{course.name}</h3>
                <p>{course.description}</p>
                <span class="btn-course" role="note">Turmas em breve</span>
              </article>
            ))}
          </div>
          <button class="carousel-arrow next" type="button" aria-label="Próximos cursos" aria-controls="course-track" data-dir="1">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6 6 6-6 6" /></svg>
          </button>
          <div class="carousel-dots" aria-hidden="true" data-dots><div class="carousel-dots-strip"></div></div>
        </div>
        <p class="carousel-hint" aria-hidden="true">Arraste para o lado para ver mais cursos
          <svg viewBox="0 0 24 24"><path d="M5 12h14M13 6l6 6-6 6" /></svg>
        </p>
      </section>

      <section class="about" id="instituto" aria-labelledby="about-title">
        <div class="container about-grid">
          <div class="about-copy">
            <p class="eyebrow about-eyebrow">O instituto</p>
            <h2 id="about-title" class="display">A Paraíba ganhou<br /> um instituto de<br class="mobile-only" /> artes</h2>
            <p>Tudo começou em 2014, com a família Beltrão e o amor pela arte que perpassa gerações. Surgiu uma ideia ousada para valorizar a arte da Paraíba: proporcionar a artistas em ascendência que possuem legado consolidado uma oportunidade para compartilhar suas artes.</p>
            <p>A aposta deu certo. Obra a obra, a coleção cresce até se tornar um grande acervo de arte da Paraíba, com mais de mil pinturas, esculturas e peças que carregam a identidade do estado. Em 2023, nasceu oficialmente o Beltrão Instituto de Artes, um espaço da arte e cultura paraibana.</p>
            <p>Uma paixão desse tamanho pede para ser compartilhada. Por isso o BIA abre suas portas para que cada paraibano e cada visitante possa conhecer a história da Paraíba e se sentir parte dela.</p>
          </div>
          <ul class="stat-list" aria-label="O Instituto em números">
            {site.statistics.map(stat => (
              <li class="stat-item">
                <span class={'stat-square bg-' + stat.color} aria-hidden="true"></span>
                <strong>{stat.value}</strong>
                <p>{stat.label}</p>
              </li>
            ))}
          </ul>
          <a href={tickets} class="btn btn-coral about-cta" {...external}>Comprar ingresso</a>
        </div>
      </section>

      <section class="faq" id="duvidas" aria-labelledby="faq-title">
        <div class="faq-container">
          <p class="eyebrow section-eyebrow">Perguntas frequentes</p>
          <h2 id="faq-title" class="display">Tem alguma<br class="mobile-only" /> dúvida?</h2>
          <div class="faq-list">
            {site.faqs.map(faq => (
              <details class="faq-item" name="faq">
                <summary>{faq.question}<span class="faq-icon" aria-hidden="true"></span></summary>
                <div class="faq-answer"><p>{faq.answer}</p></div>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="closing" id="contato" aria-labelledby="closing-title">
        <div class="closing-grid">
          <div class="closing-copy">
            <p class="eyebrow">Fale com a gente!</p>
            <h2 id="closing-title" class="display">A arte está<br />esperando<br />por você</h2>
            <p><a href={tickets} {...external}>Garanta seu ingresso!</a></p>
          </div>
          <img class="closing-photo" src={asset(site.closingImage.src)} alt={site.closingImage.alt} width="441" height="502" loading="lazy" />
        </div>
      </section>
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <a class="footer-brand" href="#inicio" aria-label="Voltar ao início">
          <img src={asset('brand.svg')} alt="Logomarca do Instituto BIA Beltrão" width="902" height="542" loading="lazy" />
        </a>
        <div class="footer-contact">
          <p class="eyebrow">{site.fullName}</p>
          <p class="desktop-only">Rua Vigário Sarlen, 29 - Centro Histórico, João Pessoa</p>
          <p class="mobile-only">Rua Vigário Sarlen, 29.<br />Centro Histórico, João Pessoa / PB.<br />Ao lado da Igreja de São Francisco.</p>
          <p><a href={site.links.whatsapp} {...external}>WhatsApp {site.visit.phone}</a> -<br class="mobile-only" /> E-mail: <a href={'mailto:' + site.links.email}>{site.links.email}</a></p>
          <p>Instagram: <a href={site.links.instagram} {...external}>@biainstitutodeartes</a></p>
        </div>
        <nav class="footer-links" aria-label="Informações legais">
          {site.links.privacy ? <a href={site.links.privacy}>Política de privacidade</a> : <span>Política de privacidade</span>}
          {site.links.terms ? <a href={site.links.terms}>Termos de compra</a> : <span>Termos de compra</span>}
        </nav>
      </div>
    </footer>

    <script is:inline>
      document.querySelectorAll('[data-carousel]').forEach(function (carousel) {
        var track = carousel.querySelector('.course-track');
        var buttons = carousel.querySelectorAll('.carousel-arrow');
        var dotsBox = carousel.querySelector('[data-dots]');
        if (!track) return;
        var cards = track.querySelectorAll('.course-card');
        var step = function () {
          var gap = parseFloat(getComputedStyle(track).columnGap) || 0;
          return cards.length ? cards[0].getBoundingClientRect().width + gap : track.clientWidth;
        };
        var maxScroll = function () { return Math.max(0, track.scrollWidth - track.clientWidth); };
        var positions = function () { return Math.max(1, Math.round(maxScroll() / step()) + 1); };
        var current = function () {
          if (track.scrollLeft >= maxScroll() - 2) return positions() - 1;
          return Math.round(track.scrollLeft / step());
        };
        var goTo = function (index) {
          track.scrollTo({ left: Math.min(index * step(), maxScroll()), behavior: 'smooth' });
        };
        // Bolinhas no estilo do Instagram: quantidade fixa de 5 inteiras; a fileira "anda"
        // quando a ativa chega na penúltima (ou na segunda, voltando).
        var VISIBLE = 5;
        var strip = dotsBox && dotsBox.querySelector('.carousel-dots-strip');
        var windowStart = 0;
        var buildDots = function () {
          if (!strip) return;
          var total = positions();
          if (strip.children.length === total) return;
          strip.innerHTML = '';
          for (var i = 0; i < total; i++) {
            var dot = document.createElement('span');
            dot.style.setProperty('--i', i);
            strip.appendChild(dot);
          }
          windowStart = 0;
        };
        var renderDots = function (index) {
          if (!strip) return;
          var total = strip.children.length;
          var visible = Math.min(VISIBLE, total);
          if (index > windowStart + visible - 2 && index < total - 1) windowStart = index - (visible - 2);
          if (index === total - 1) windowStart = total - visible;
          if (index < windowStart + 1 && index > 0) windowStart = index - 1;
          if (index === 0) windowStart = 0;
          windowStart = Math.max(0, Math.min(windowStart, total - visible));
          // Centraliza a janela de 5 dentro das 9 posições (2 de folga de cada lado).
          var shift = total <= VISIBLE ? (9 - total) / 2 : 2 - windowStart;
          strip.style.setProperty('--shift', shift);
          Array.prototype.forEach.call(strip.children, function (dot, i) {
            var outside = i < windowStart ? windowStart - i : i - (windowStart + visible - 1);
            var scale = outside <= 0 ? 1 : outside === 1 ? 0.62 : outside === 2 ? 0.36 : 0;
            dot.style.setProperty('--s', scale);
            dot.classList.toggle('is-active', i === index);
          });
        };
        var update = function () {
          var index = current();
          var max = maxScroll() - 2;
          buttons.forEach(function (button) {
            button.disabled = Number(button.dataset.dir) < 0 ? track.scrollLeft <= 2 : track.scrollLeft >= max;
          });
          renderDots(index);
        };
        buttons.forEach(function (button) {
          button.addEventListener('click', function () { goTo(current() + Number(button.dataset.dir)); });
        });
        track.addEventListener('keydown', function (event) {
          if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
          event.preventDefault();
          goTo(current() + (event.key === 'ArrowRight' ? 1 : -1));
        });

        // Arrastar com o mouse no computador (no celular o gesto de deslizar já é nativo).
        var dragging = false, moved = false, startX = 0, startScroll = 0;
        track.addEventListener('pointerdown', function (event) {
          if (event.pointerType !== 'mouse' || event.button !== 0) return;
          dragging = true; moved = false; startX = event.clientX; startScroll = track.scrollLeft;
          track.classList.add('is-dragging');
          track.setPointerCapture(event.pointerId);
        });
        track.addEventListener('pointermove', function (event) {
          if (!dragging) return;
          var delta = event.clientX - startX;
          if (Math.abs(delta) > 4) moved = true;
          track.scrollLeft = startScroll - delta;
        });
        var endDrag = function () {
          if (!dragging) return;
          dragging = false;
          track.classList.remove('is-dragging');
          if (moved) goTo(Math.round(track.scrollLeft / step()));
        };
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('click', function (event) { if (moved) { event.preventDefault(); moved = false; } }, true);

        track.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', function () { buildDots(); update(); });
        buildDots();
        update();
      });
    </script>
  </body>
</html>
